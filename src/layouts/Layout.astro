---
import directus, { directusUrl } from "@/lib/directus";
import "@/styles/global.css";
import { readSingleton } from "@directus/sdk";
import "@fontsource/courier-prime";
import "@fontsource/courier-prime/700.css";
import "@fontsource/courier-prime/400-italic.css";
import { SEO } from "astro-seo";

type Props = {
  title: string;
  label: string;
  description?: string;
  social_cover?: string;
};

const global = await directus.request(readSingleton("global"));

const { title, label, description = "", social_cover = "" } = Astro.props;
const path = Astro.url.pathname;
const menu = [
  { href: "/projects", text: "Projects", active: path.includes("/project") },
  {
    href: "/exit",
    text: "Exit Through the Gift Shop",
    active: path.startsWith("/exit"),
  },
  {
    href: "/",
    text: "About",
    active: path === "/" || path.startsWith("/about"),
  },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width" />
    <SEO
      title=`${title} 🟨 ${global.title}`
      description={description}
      openGraph={{
        basic: {
          title: `${title} 🟨 ${global.title}`,
          type: "website",
          image: `${directusUrl}/assets/${social_cover}?width=500`,
        },
        optional: {
          description,
        },
      }}
      charset="UTF-8"
      extend={{
        link: [{ rel: "icon", href: "/favicon.ico" }],
      }}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class="mx-auto flex min-h-screen max-w-3xl flex-col px-[26px] md:px-10">
    <header class="flex items-baseline justify-between pt-10 text-[15px]">
      <a href="/" class="font-bold">{global.title}</a>
      <button
        type="button"
        class="cursor-pointer"
        aria-controls="menu"
        aria-expanded="false"
        data-menu-open
      >
        Menu +
      </button>
    </header>

    <main class="flex-grow pt-12">
      <p class="label">( {label} )</p>
      <slot />
    </main>

    <footer class="pt-40 pb-10">
      <form
        id="newsletter-form"
        data-directus-url={directusUrl}
        class="border-t border-current"
      >
        <label for="nl-name" class="sr-only">Name</label>
        <input
          id="nl-name"
          name="name"
          type="text"
          autocomplete="given-name"
          placeholder="Name"
          class="block w-full border-b border-current bg-transparent py-4 outline-none placeholder:text-gray-400"
        />
        <div class="flex items-center border-b border-current">
          <label for="nl-email" class="sr-only">Email</label>
          <input
            id="nl-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="Email"
            required
            class="block w-full bg-transparent py-4 outline-none placeholder:text-gray-400"
          />
          <button
            id="nl-submit"
            type="submit"
            class="hover:text-main cursor-pointer whitespace-nowrap"
          >
            Subscribe →
          </button>
        </div>
        <p
          class="mt-5 text-[13px] text-gray-600"
          id="nl-status"
          aria-live="polite"
        >
          No spam, just art. <a href="/privacy_policy" class="link-main"
            >Privacy Policy</a
          >
        </p>
      </form>

      <nav class="mt-8 flex gap-6 text-[15px]">
        <a href={global.Footer_CTA_URL_1} target="_blank" rel="noopener">
          {global.Footer_CTA_TEXT_1}
        </a>
        <a href={global.Footer_CTA_URL_2} data-fomo
          >{global.Footer_CTA_TEXT_2}</a
        >
      </nav>

      <p class="mt-6 text-[11px] text-gray-600">
        &copy; 2018-{year}
        {global.title}. All rights reserved.
      </p>
    </footer>

    <div
      id="menu"
      class="fixed inset-0 z-20 hidden overflow-y-auto bg-white"
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
    >
      <div
        class="mx-auto flex min-h-full max-w-3xl flex-col px-[26px] md:px-10"
      >
        <div class="flex items-baseline justify-between pt-10 text-[15px]">
          <a href="/" class="font-bold">{global.title}</a>
          <button type="button" class="cursor-pointer" data-menu-close>
            Close ←
          </button>
        </div>
        <nav class="flex-grow pt-12">
          <p class="label">( Menu )</p>
          <ul class="mt-6 flex flex-col gap-8 text-3xl leading-tight">
            {
              menu.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.active ? "page" : undefined}
                    class:list={[
                      "block border-b-[3px]",
                      item.active
                        ? "border-main"
                        : "hover:border-main border-transparent",
                    ]}
                  >
                    {item.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav class="flex gap-6 border-t border-current pt-5 pb-10 text-[15px]">
          <a href={global.Footer_CTA_URL_1} target="_blank" rel="noopener">
            {global.Footer_CTA_TEXT_1}
          </a>
          <a href={global.Footer_CTA_URL_2} data-fomo
            >{global.Footer_CTA_TEXT_2}</a
          >
        </nav>
      </div>
    </div>
  </body>
</html>

<script>
  import { createDirectus, createItem, rest } from "@directus/sdk";

  console.log(
    "%c Giallo Giallo Project %c no spam, just art ",
    "background:rgb(250,183,0);color:#000;font:bold 14px 'Courier Prime',monospace;padding:4px 8px",
    "background:#fff;color:#000;font:14px 'Courier Prime',monospace;padding:4px 8px",
  );

  const menu = document.getElementById("menu");
  const openButton =
    document.querySelector<HTMLButtonElement>("[data-menu-open]");

  function setMenu(open: boolean) {
    menu?.classList.toggle("hidden", !open);
    document.documentElement.classList.toggle("overflow-hidden", open);
    openButton?.setAttribute("aria-expanded", String(open));
  }

  openButton?.addEventListener("click", () => setMenu(true));
  document
    .querySelector("[data-menu-close]")
    ?.addEventListener("click", () => setMenu(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });

  const form = document.querySelector<HTMLFormElement>("#newsletter-form");
  const nameInput = document.querySelector<HTMLInputElement>("#nl-name");

  document.querySelectorAll("[data-fomo]").forEach((fomo) =>
    fomo.addEventListener("click", (e) => {
      e.preventDefault();
      setMenu(false);
      form?.scrollIntoView({ behavior: "smooth", block: "center" });
      nameInput?.focus({ preventScroll: true });
    }),
  );

  const directusUrl = form?.dataset.directusUrl;
  const directus = directusUrl
    ? createDirectus(directusUrl).with(rest())
    : null;
  const status = document.getElementById("nl-status");
  const submit = document.querySelector<HTMLButtonElement>("#nl-submit");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!directus || !status || !submit) return;
    const formData = new FormData(form);
    submit.disabled = true;
    try {
      await directus.request(
        createItem("contacts", {
          name: formData.get("name"),
          email: formData.get("email"),
        }),
      );
      form.reset();
      status.textContent = "Hooray, we will keep you updated!";
      status.classList.replace("text-gray-600", "text-black");
    } catch (error) {
      status.textContent = "Subscription failed. Please try again.";
      console.error("Newsletter subscription failed", { directusUrl, error });
    } finally {
      submit.disabled = false;
    }
  });
</script>
