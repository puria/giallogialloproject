---
import Layout from "@/layouts/Layout.astro";
import directus, { directusUrl } from "@/lib/directus";
import { readItems } from "@directus/sdk";

const ex = await directus.request(readItems("exit_images", { fields: ["*"] }));
---

<Layout title="Exit Through the Gift Shop" label="Exit Through the Gift Shop">
  <div class="mt-4 grid grid-cols-1 gap-12 border-t border-current pt-8">
    {
      ex.map((e, x) => (
        <div class="flex flex-col gap-4">
          <img
            src={`${directusUrl}/assets/${e.image}?key=ex`}
            alt={`Exit #${x + 1}`}
            loading="lazy"
            decoding="async"
          />
          <div class="prose-ggp" set:html={e.description} />
        </div>
      ))
    }
  </div>
</Layout>
