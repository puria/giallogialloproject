---
import Layout from "@/layouts/Layout.astro";
import directus, { directusUrl } from "@/lib/directus";
import { readItems } from "@directus/sdk";

const ex = await directus.request(readItems("exit_images", { fields: ["*"] }));
---

<Layout title="Exit Through the Gift Shop">
  <div class="grid-col-1 grid gap-8 p-20 pt-12">
    {
      ex.map((e, x) => (
        <div class="flex flex-col gap-4">
          <img
            src={`${directusUrl}/assets/${e.image}?key=ex`}
            alt={`Exit #${x + 1}`}
            class="border-main border"
            loading="lazy"
            decoding="async"
          />
          <div class="prose pt-4 text-justify" set:html={e.description} />
        </div>
      ))
    }

    <!--, x: number) =>-->
    <!--)}-->
  </div>
</Layout>
